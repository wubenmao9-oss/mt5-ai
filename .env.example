# ============================================
#   MT5-Ai 智能交易系统 配置文件
#   修改后需重启 run.py 生效
# ============================================

# ---- MT5 账户配置 ----
MT5_LOGIN=                         # MT5 账号
MT5_PASSWORD=                      # MT5 密码
MT5_SERVER=                        # MT5 服务器（服务商名称）
MT5_SYMBOL=XAUUSD                  # 交易品种（如 XAUUSD=黄金, EURUSD=欧美）
MT5_VOLUME=0.01                    # 手数

# ---- 策略选择 ----
# 可选: V2, V3, V4, V5, B1, B2
# B2 = 趋势+均值回归混合策略（推荐）
ACTIVE_STRATEGY=B2

# ---- 邮件报警（可选，不填则不发送）----
EMAIL_SENDER=                      # 发件邮箱（QQ邮箱）
EMAIL_PASSWORD=                    # 邮箱授权码（非登录密码）
EMAIL_RECEIVER=                    # 收件邮箱
EMAIL_SMTP_HOST=smtp.qq.com        # SMTP服务器
EMAIL_SMTP_PORT=587                # SMTP端口

# ---- 行情数据源（一般不用改）----
INFOWAY_TOKEN=                     # Infoway API Token
INFOWAY_SYMBOL=XAUUSD
ALLTICK_TOKEN=                     # AllTick API Token
ALLTICK_SYMBOL=GOLD

# ---- 策略云端更新（可选）----
GITEE_OWNER=                       # Gitee 用户名
GITEE_REPO=mt5-strategies          # Gitee 仓库名
GITEE_TOKEN=                       # Gitee 私人令牌
ADMIN_KEY=你的密钥                  # 管理端 X-Admin-Key

# ---- 卡密授权 llua.cn V2（可选）----
LLUA_APPKEY=你的LLUA_APPKEY
LLUA_APITOKEN=你的LLUA_APITOKEN
LLUA_LOGIN_ID=你的LLUA_LOGIN_ID
LLUA_HEARTBEAT_ID=你的LLUA_HEARTBEAT_ID
LLUA_SUCCESS_CODE=0                # 登录成功状态码，按实际接口填写
